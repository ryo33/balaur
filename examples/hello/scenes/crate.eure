// A prefab: any scene file a node can name with `instance`. Its nodes become
// that node's children, with ids prefixed by the instance's, so two crates in
// one scene never share an identity.

@ nodes[] {
  id: n_crate
  name: Crate
  body3d: dynamic

  // The canonical spelling. `color = [r, g, b]` is the shorthand and means the
  // same thing, but an editor override is written this way, so a prefab that
  // expects to be overridden reads better in full.
  @ color
  rgba = [0.72, 0.52, 0.28, 1.0]

  @ collider3d
  half_extents = [0.35, 0.35, 0.35]
  kind: cuboid

  @ shape3d
  half_extents = [0.35, 0.35, 0.35]
  kind: cuboid
}

@ nodes[] {
  id: n_lid
  name: Lid
  parent: n_crate
  position = [0, 0.4, 0]

  @ color
  rgba = [0.45, 0.32, 0.17, 1.0]

  @ shape3d
  half_extents = [0.37, 0.05, 0.37]
  kind: cuboid
}
